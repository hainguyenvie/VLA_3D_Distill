# Cluster identity — the only file that knows which machine this project runs on.
# cp infra.env.example infra.env && $EDITOR infra.env   (infra.env is gitignored)
# main machine (2x L40, shared account): keep everything inside one workspace folder
L40_SSH=            # ssh alias from the operator's ~/.ssh/config (key login)
L40_REMOTE_ROOT=    # workspace on that machine, relative to the remote home (one folder per project, next to other projects)
# H200 machine: NOT available to this project by default — ask the operator before using it
H200_SSH=           # ssh alias (leave empty until the operator hands the card over)
H200_REMOTE_ROOT=   # project root on that machine, relative to the remote home
# 8x H200 node (from 06/10): main machine for this project; k8s container, cgroup 32 CPU / 512 GiB
TENSARA_SSH=        # ssh alias
TENSARA_REMOTE_ROOT=  # workspace, relative to the remote home (projects/<project folder>)
